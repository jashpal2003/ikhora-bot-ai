# Project Relay — Environment Configuration Template

ENVIRONMENT=development
DEBUG=true

# Databases
DATABASE_URL=postgresql+asyncpg://relay_app:relay_password@localhost:5432/relay_db
REDIS_URL=redis://localhost:6379/0

# Temporal Cloud / Local Dev Server
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=relay-agent-queue

# Azure Integration
AZURE_REGION=westeurope
AZURE_KEY_VAULT_URI=
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_AUDIT_CONTAINER=audit-events

# Channels
WHATSAPP_VERIFY_TOKEN=relay_dev_verify_token
WHATSAPP_APP_SECRET=relay_dev_secret

# Models & Decisions
DEFAULT_LLM_MODEL=gpt-4o-mini
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
JEV_API_URL=https://api.typesafe.ai/v1/decide
JEV_API_KEY=
